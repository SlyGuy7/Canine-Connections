# Copy to backend/.env and fill in real values. Never commit the real .env.

#---------------- App ----------------
APP_ENV=production
APP_DEBUG=false
APP_KEY=change-me-32-byte-random-string

#---------------- MySQL --------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=adoption_center
DB_USER=adoption_user
DB_PASS=change-me

#---------------- RabbitMQ -----------
RABBITMQ_HOST=127.0.0.1
RABBITMQ_HOST2=
RABBITMQ_HOST3=
RABBITMQ_PORT=5672
RABBITMQ_USER=change-me
RABBITMQ_PASS=change-me
RABBITMQ_VHOST=/

#---------------- Email --------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=change-me
MAIL_FROM_NAME="Canine Connections"
RESEND_API_KEY=

#---------------- Services -----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=7012
