# Copy to database/.env. Read by db_worker.php and the scripts in database/scripts/.
# Quote values that contain special characters.

DB_HOST=127.0.0.1
DB_HOST_2=
DB_HOST_3=
DB_PORT=3306
DB_NAME=adoption_center
DB_USER=adoption_user
DB_PASS="change-me"

RABBITMQ_HOST=127.0.0.1
RABBITMQ_HOST2=
RABBITMQ_HOST3=
RABBITMQ_PORT=5672
RABBITMQ_USER=change-me
RABBITMQ_PASS="change-me"

# Used only by scripts/Reboot_Clusters.sh
# sudo password on the LB VM
DERYK_PASS="change-me"
# sudo password on Node 1
STEVENV_PASS="change-me"
# MySQL group-replication recovery user password
REPL_PASS="change-me"
