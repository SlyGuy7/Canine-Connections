# Copy to frontend/.env before `npm run dev` / `npm run build`.
# VITE_* values are embedded in the built JS and visible to every visitor, so this must be
# the restricted web user created by infra/rabbitmq/setup_web_user.sh, never an admin account.
VITE_MQ_LOGIN=canine_web
VITE_MQ_PASSCODE=change-me
