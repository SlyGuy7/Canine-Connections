RESCUEGROUPS_API_KEY=change-me
DEFAULT_SHELTER_ID=1

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=change-me
RABBITMQ_PASS=change-me
