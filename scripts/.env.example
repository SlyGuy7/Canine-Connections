# Copy to scripts/.env. Read by dev.sh, security.sh and rejoin_rabbitmq.sh.

SSH_KEY=~/.ssh/id_ed25519

RABBITMQ_USER=
RABBITMQ_HOST=
MYSQL_USER=
MYSQL_HOST=
PHP_USER=
PHP_HOST=
PHP_DIR=~/Canine-Connections/backend
PHP_PORT=8000
FRONTEND_USER=
FRONTEND_HOST=
FRONTEND_DIR=~/Canine-Connections/frontend
FRONTEND_PORT=7012

LOCAL_RABBITMQ_AMQP_PORT=5672
LOCAL_RABBITMQ_UI_PORT=15672
LOCAL_MYSQL_PORT=3306
LOCAL_PHP_PORT=8000
LOCAL_FRONTEND_PORT=7012
